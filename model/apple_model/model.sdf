<?xml version="1.0"?>
<sdf version="1.7">

  <model name="apple">

    <!-- 苹果本体：红色球体，半径0.045m（约真实苹果大小） -->
    <link name="apple_body">
      <visual name="apple_visual">
        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.8 0.02 0.02 1</diffuse>
        </material>
      </visual>
      <collision name="apple_collision">
        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>
      </collision>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000101</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000101</iyy><iyz>0</iyz>
          <izz>0.000101</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 苹果柄：细小棕色圆柱 -->
    <link name="apple_stem">
      <pose>0 0 0.045 0 0 0</pose>
      <visual name="stem_visual">
        <geometry>
          <cylinder>
            <radius>0.004</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.22 0.08 1</ambient>
          <diffuse>0.3 0.18 0.06 1</diffuse>
        </material>
      </visual>
      <collision name="stem_collision">
        <geometry>
          <cylinder>
            <radius>0.004</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <pose>0 0 0.0125 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>8e-9</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>8e-9</iyy><iyz>0</iyz>
          <izz>1.6e-10</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 固定关节连接苹果和柄 -->
    <joint name="body_to_stem" type="fixed">
      <parent>apple_body</parent>
      <child>apple_stem</child>
    </joint>

    <!--
      FruitManager creates this template through Fortress UserCommands.
      It injects <static>true</static> for on-tree fruit and recreates the
      model with <static>false</static> on detach, preserving this collision
      and inertia data so the detached apple can fall naturally.
    -->

  </model>

</sdf>
