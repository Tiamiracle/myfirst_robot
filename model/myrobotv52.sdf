          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ==================== 关节定义（按PDF第5章） ==================== -->

    <!-- 升降基座固定关节 -->
    <joint name="lift_base_joint" type="fixed">
      <parent>base_link</parent>
      <child>lift_base</child>
    </joint>

    <!-- 滑轨固定关节 -->
    <joint name="lift_slide_joint" type="fixed">
      <parent>base_link</parent>
      <child>lift_slide</child>
    </joint>

    <!-- 升降平台关节 (prismatic, Z轴, 范围0~0.8m) -->
    <joint name="platform_joint" type="prismatic">
      <parent>lift_slide</parent>
      <child>lift_platform</child>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>0</lower>
          <upper>0.8</upper>
          <effort>200</effort>
          <velocity>0.3</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 手臂旋转关节 (revolute, Z轴, 范围-π~π) -->
    <joint name="arm_rot_joint" type="revolute">
      <parent>lift_platform</parent>
      <child>arm_rot_base</child>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>150</effort>
          <velocity>1.2</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 大臂俯仰关节 (revolute, Y轴, 范围-0.785~1.57) -->
    <joint name="arm_upper_pitch_joint" type="revolute">
      <parent>arm_rot_base</parent>
      <child>arm_upper_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.785</lower>
          <upper>1.57</upper>
          <effort>120</effort>
          <velocity>1</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 前臂伸缩关节 (prismatic, X轴, 范围0~0.3m) -->
    <joint name="arm_forearm_extend_joint" type="prismatic">
      <parent>arm_upper_link</parent>
      <child>arm_extend_forearm</child>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>0</lower>
          <upper>0.3</upper>
          <effort>80</effort>
          <velocity>0.25</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 腕部旋转关节 (revolute, X轴, 范围-1.57~1.57) -->
    <joint name="wrist_rotate_joint" type="revolute">
      <parent>arm_extend_forearm</parent>
      <child>arm_wrist_rot</child>
      <pose>0.18 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>40</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 夹爪基座固定关节 -->
    <joint name="gripper_fixed_joint" type="fixed">
      <parent>arm_wrist_rot</parent>
      <child>gripper_base</child>
      <pose>0.06 0 0 -3.1415926 0 -3.1415926</pose>
    </joint>

    <!-- 手指1关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger1_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_1</child>
      <pose>0 0.04 -0.07 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger1_force" type="force_torque">
        <update_rate>1</update_rate>
        <enable>true</enable>
        <topic>/finger1_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- 手指2关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger2_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_2</child>
      <pose>0 -0.04 -0.07 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger2_force" type="force_torque">
        <update_rate>1</update_rate>
        <enable>true</enable>
        <topic>/finger2_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- 手指3关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger3_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_3</child>
      <pose>0 0 0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger3_force" type="force_torque">
        <update_rate>1</update_rate>
        <enable>true</enable>
        <topic>/finger3_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- ==================== Gazebo 插件（按PDF第5.3节） ==================== -->

    <!-- 关节状态发布器 -->
    <plugin filename="gz-sim-joint-state-publisher-system"
             name="gz::sim::systems::JointStatePublisher">
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <joint_name>platform_joint</joint_name>
        <joint_name>arm_rot_joint</joint_name>
        <joint_name>arm_upper_pitch_joint</joint_name>
        <joint_name>arm_forearm_extend_joint</joint_name>
        <joint_name>wrist_rotate_joint</joint_name>
        <joint_name>finger1_joint</joint_name>
        <joint_name>finger2_joint</joint_name>
        <joint_name>finger3_joint</joint_name>
        <topic>/joint_states</topic>
        <update_rate>30</update_rate>
    </plugin>

    <!-- 传感器系统 -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 场景广播器 -->
    <plugin filename="gz-sim-scene-broadcaster-system"
             name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 升降平台位置控制器 P=100, I=0, D=10 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>platform_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>100</p_gain>
        <i_gain>0</i_gain>
        <d_gain>10</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/platform_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 手臂旋转位置控制器 P=100, I=0, D=10 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>arm_rot_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>100</p_gain>
        <i_gain>0</i_gain>
        <d_gain>10</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/arm_rot_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 大臂俯仰位置控制器 P=150, I=0, D=15 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>arm_upper_pitch_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>150</p_gain>
        <i_gain>0</i_gain>
        <d_gain>15</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/arm_upper_pitch_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 前臂伸缩位置控制器 P=50, I=0, D=5 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>arm_forearm_extend_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>50</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/arm_forearm_extend_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 腕部旋转位置控制器 P=50, I=0, D=5 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>wrist_rotate_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>50</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/wrist_rotate_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 手指1位置控制器 P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>finger1_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>30</p_gain>
        <i_gain>0</i_gain>
        <d_gain>3</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/finger1_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 手指2位置控制器 P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>finger2_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>30</p_gain>
        <i_gain>0</i_gain>
        <d_gain>3</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/finger2_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 手指3位置控制器 P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
             name="gz::sim::systems::JointPositionController">
        <joint_name>finger3_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>30</p_gain>
        <i_gain>0</i_gain>
        <d_gain>3</d_gain>
        <cmd_topic>/model/vehicle_blue/joint/finger3_joint/cmd_pos</cmd_topic>
    </plugin>

    <!-- 力/力矩传感器系统插件 -->
    <plugin filename='libgz-sim8-forcetorque-system.so'
             name='gz::sim::systems::ForceTorque'></plugin>

  </model>

</sdf>