    <!-- ========== 8. 夹爪基座 ========= -->
    <link name="gripper_base">
      <pose>0.24 0 0.363 -3.1415926 0 -3.1415926</pose>
      <visual name="gripper_base_visual_0">
        <geometry>
          <box>
            <size>0.05 0.15 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.94902353 0.94118039 0.90980784 1.00000000</ambient>
