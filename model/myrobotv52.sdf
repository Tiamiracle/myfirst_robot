    <!-- 激光雷达（带gpu_lidar传感器） -->
    <link name="laser_link">
      <pose>0.3 0 0.27 0 0 0</pose>
      <visual name="laser_link_visual_0">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <name>black_trans2</name>
          <ambient>0.00000000 0.00000000 0.00000000 0.80000000</ambient>
          <diffuse>0.00000000 0.00000000 0.00000000 0.80000000</diffuse>
        </material>
      </visual>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00000375</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00000375</iyy>
          <iyz>0</iyz>
          <izz>0.0000075</izz>
        </inertia>
      </inertial>

      <!-- GPU LiDAR传感器（Gazebo Sim原生格式，由gz-sim-sensors-system驱动） -->
      <sensor name="hls_lfcd_lds" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.000000</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1.000000</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>20.0</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- ==================== 底盘关节 ==================== -->
    <joint name="caster_joint" type="revolute">
      <parent>base_link</parent>
      <child>caster_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-3.1415927</lower>
          <upper>3.1415927</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="laser_cylinder_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser_cylinder_link</child>
    </joint>

    <joint name="laser_joint" type="fixed">
      <parent>laser_cylinder_link</parent>
      <child>laser_link</child>
    </joint>

    <!-- ============================================================ -->
    <!-- 果园采摘机械臂（完全按照PDF第5章 orchard_robot 定义）       -->
    <!-- 结构: lift_base -> lift_slide -> lift_platform(升降)         -->
    <!--     -> arm_rot_base(旋转) -> arm_upper_link(大臂俯仰)        -->
    <!--     -> arm_extend_forearm(前臂伸缩X轴) -> arm_wrist_rot(腕部旋转) -->
    <!--     -> gripper_base -> finger_1/2/3 (三指夹爪)               -->
    <!-- ============================================================ -->

    <!-- ========== 1. 升降机构基座 ========= -->
    <link name="lift_base">
      <pose>-0.25 0 0.167 0 0 0</pose>
      <visual name="lift_base_visual_0">
        <geometry>
          <box>
            <size>0.12 0.12 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30196471 0.30196471 0.30196471 1.00000000</ambient>
          <diffuse>0.30196471 0.30196471 0.30196471 1.00000000</diffuse>
        </material>
      </visual>
      <collision name="lift_base_collision_0">
        <geometry>
          <box>
            <size>0.12 0.12 0.2</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.004</iyy>
          <iyz>0</iyz>
          <izz>0.004</izz>
        </inertia>
      </inertial>
    </link>

