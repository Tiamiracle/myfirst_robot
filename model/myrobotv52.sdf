    <link name="laser_link">
      <pose>0.3 0 0.27 0 0 0</pose>
      <visual name="laser_link_visual_0">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
