    <!--
      末端 RGB-D 相机。相机固定在夹爪前方，光轴沿 camera_link 的 +X 方向，
      以便机械臂靠近果实时获得近距离观测。RGB 与深度使用独立的 Fortress
      传感器，分别发布 Image 和 CameraInfo，供 ros_gz_bridge 转为 ROS 2 话题。
    -->
    <link name="camera_link">
      <visual name="camera_housing">
        <geometry>
          <box>
            <size>0.06 0.09 0.05</size>
          </box>
        </geometry>
        <material>
          <!-- 红色仅用于调试时在 Gazebo 中快速确认相机安装位置。 -->
          <ambient>0.9 0.02 0.02 1</ambient>
          <diffuse>0.9 0.02 0.02 1</diffuse>
        </material>
      </visual>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <sensor name="rgb_camera" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/camera/color/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.22173</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="depth_camera" type="depth_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/camera/depth/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.22173</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

