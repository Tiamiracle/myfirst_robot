    </link>

    <!-- ========== 10. 手指2 (左侧手指) ========= -->
    <link name="finger_2">
      <pose>0.22 -0.04 0.293 0 0 0</pose>
      <visual name="finger_2_visual_0">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20000392 0.40000392 0.80000392 1.00000000</ambient>
          <diffuse>0.20000392 0.40000392 0.80000392 1.00000000</diffuse>
        </material>
      </visual>
      <collision name="finger_2_collision_0">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ========== 11. 手指3 (上方手指) ========= -->
    <link name="finger_3">
      <pose>0.22 0 0.413 0 0 0</pose>
      <visual name="finger_3_visual_0">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20000392 0.40000392 0.80000392 1.00000000</ambient>
          <diffuse>0.20000392 0.40000392 0.80000392 1.00000000</diffuse>
        </material>
      </visual>
      <collision name="finger_3_collision_0">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ==================== 机械臂关节定义（按PDF第5章） ==================== -->

    <!-- 升降基座固定关节 -->
    <joint name="lift_base_joint" type="fixed">
      <parent>base_link</parent>
      <child>lift_base</child>
    </joint>

    <!-- 滑轨固定关节 -->
    <joint name="lift_slide_joint" type="fixed">
      <parent>base_link</parent>
      <child>lift_slide</child>
    </joint>

    <!-- 升降平台关节 (prismatic, Z轴, 范围0~0.8m) -->
    <joint name="platform_joint" type="prismatic">
      <parent>lift_slide</parent>
      <child>lift_platform</child>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>0</lower>
          <upper>0.8</upper>
          <effort>200</effort>
          <velocity>0.3</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 手臂旋转关节 (revolute, Z轴, 范围-π~π) -->
    <joint name="arm_rot_joint" type="revolute">
      <parent>lift_platform</parent>
      <child>arm_rot_base</child>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-3.14</lower>
          <upper>3.14</upper>
          <effort>150</effort>
          <velocity>1.2</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 大臂俯仰关节 (revolute, Y轴, 范围-0.785~1.57) -->
    <joint name="arm_upper_pitch_joint" type="revolute">
      <parent>arm_rot_base</parent>
      <child>arm_upper_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.785</lower>
          <upper>1.57</upper>
          <effort>120</effort>
          <velocity>1</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 前臂伸缩关节 (prismatic, X轴, 范围0~0.3m) -->
    <joint name="arm_forearm_extend_joint" type="prismatic">
      <parent>arm_upper_link</parent>
      <child>arm_extend_forearm</child>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>0</lower>
          <upper>0.3</upper>
          <effort>80</effort>
          <velocity>0.25</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 腕部旋转关节 (revolute, X轴, 范围-1.57~1.57) -->
    <joint name="wrist_rotate_joint" type="revolute">
      <parent>arm_extend_forearm</parent>
      <child>arm_wrist_rot</child>
      <pose>0.18 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>40</effort>
          <velocity>1.5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- 夹爪基座固定关节 -->
    <joint name="gripper_fixed_joint" type="fixed">
      <parent>arm_wrist_rot</parent>
      <child>gripper_base</child>
      <pose>0.06 0 0 -3.1415926 0 -3.1415926</pose>
    </joint>

    <joint name="camera_fixed_joint" type="fixed">
      <parent>gripper_base</parent>
      <child>camera_link</child>
      <pose>0.15 0 0.03 0 -0.2 0</pose>
    </joint>

    <!-- 手指1关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger1_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_1</child>
      <pose>0 0.04 -0.07 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger1_force" type="force_torque">
        <update_rate>50</update_rate>
        <enable>true</enable>
        <topic>/finger1_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- 手指2关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger2_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_2</child>
      <pose>0 -0.04 -0.07 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger2_force" type="force_torque">
        <update_rate>50</update_rate>
        <enable>true</enable>
        <topic>/finger2_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- 手指3关节 (revolute, Y轴, 带力传感器) -->
    <joint name="finger3_joint" type="revolute">
      <parent>gripper_base</parent>
      <child>finger_3</child>
      <pose>0 0 0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>false</use_parent_model_frame>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>15</effort>
          <velocity>2</velocity>
        </limit>
      </axis>
      <sensor name="finger3_force" type="force_torque">
        <update_rate>50</update_rate>
        <enable>true</enable>
        <topic>/finger3_force</topic>
        <force_torque>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
        <visualize>true</visualize>
      </sensor>
    </joint>

    <!-- ==================== Gazebo Sim Fortress 插件 ==================== -->

    <!-- 1. 场景广播器（发布TF树到/world/pose等话题） -->
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />

    <!-- 2. 差速底盘控制器（替代 libgazebo_ros_diff_drive.so） -->
    <plugin filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.133</wheel_radius>
      <topic>/cmd_vel</topic>
      <frame_id>base_link</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odom_topic>odom</odom_topic>
    </plugin>

    <!-- 3. 传感器系统（驱动激光雷达、相机等所有传感器） -->
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors" />

    <!-- 4. 关节状态发布器（发布 /joint_states 到ROS） -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>platform_joint</joint_name>
      <joint_name>arm_rot_joint</joint_name>
      <joint_name>arm_upper_pitch_joint</joint_name>
      <joint_name>arm_forearm_extend_joint</joint_name>
      <joint_name>wrist_rotate_joint</joint_name>
      <joint_name>finger1_joint</joint_name>
      <joint_name>finger2_joint</joint_name>
      <joint_name>finger3_joint</joint_name>
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>

    <!-- 5. 力/力矩传感器系统（通用名，Fortress自动解析为libgz-sim6-...） -->
    <plugin filename="gz-sim-forcetorque-system"
      name="gz::sim::systems::ForceTorque" />

    <!-- ========== 8个机械臂关节位置控制器（JointPositionController） ========== -->

    <!-- J1: 升降平台 P=100, I=0, D=10 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>platform_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>10</d_gain>
      <topic>/arm/lift_cmd</topic>
    </plugin>

    <!-- J2: 手臂旋转 P=100, I=0, D=10 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_rot_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>10</d_gain>
      <topic>/arm/rot_cmd</topic>
    </plugin>

    <!-- J3: 大臂俯仰 P=150, I=0, D=15 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_upper_pitch_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>150</p_gain>
      <i_gain>0</i_gain>
      <d_gain>15</d_gain>
      <topic>/arm/shoulder_cmd</topic>
    </plugin>

    <!-- J4: 前臂伸缩 P=50, I=0, D=5 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>arm_forearm_extend_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>50</p_gain>
      <i_gain>0</i_gain>
      <d_gain>5</d_gain>
      <topic>/arm/forearm_cmd</topic>
    </plugin>

    <!-- J5: 腕部旋转 P=50, I=0, D=5 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_rotate_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>50</p_gain>
      <i_gain>0</i_gain>
      <d_gain>5</d_gain>
      <topic>/arm/wrist_cmd</topic>
    </plugin>

    <!-- J6: 手指1(右) P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>finger1_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>3</d_gain>
      <topic>/arm/finger1_cmd</topic>
    </plugin>

    <!-- J7: 手指2(左) P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>finger2_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>3</d_gain>
      <topic>/arm/finger2_cmd</topic>
    </plugin>

    <!-- J8: 手指3(上) P=30, I=0, D=3 -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>finger3_joint</joint_name>
      <use_force_commands>false</use_force_commands>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>3</d_gain>
      <topic>/arm/finger3_cmd</topic>
    </plugin>

  </model>

</sdf>