<?xml version="1.0"?>
<sdf version="1.7">
  <world name="orchard_world">

    <!--
      Declaring a world system plugin disables Gazebo Fortress' implicit
      defaults. Keep UserCommands for entity lifecycle and SceneBroadcaster so
      the GUI receives visuals for dynamically created apples. Do not add a
      world Physics system here: this project currently relies on its existing
      robot physics configuration, and a world-level replacement changes the
      mobile base and arm behaviour.
    -->
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- ============================================ -->
    <!-- 1. 地面（草地） -->
    <!-- ============================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.55 0.2 1</ambient>
            <diffuse>0.3 0.5 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- 2. 太阳光源 -->
    <!-- ============================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0.3 0.5 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.18 1</specular>
      <attenuation>
        <range>1500</range>
        <constant>0.9</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 环境光补充 -->
    <light type="point" name="ambient_fill">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.15 0.18 0.12 1</diffuse>
      <attenuation>
        <range>80</range>
        <constant>1</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ============================================ -->
    <!-- 3. 果园围栏（4面，高度0.8m） -->
    <!-- ============================================ -->

    <!-- 北围栏 (y=15) -->
    <model name="fence_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>50 0.15 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>50 0.15 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.5 0.32 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 15 0.4 0 0 0</pose>
    </model>

    <!-- 南围栏 (y=-15) - 带入口缺口(宽4m) -->
    <model name="fence_south_left">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>21 0.15 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>21 0.15 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.5 0.32 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-14.5 -15 0.4 0 0 0</pose>
    </model>

    <model name="fence_south_right">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>21 0.15 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>21 0.15 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.5 0.32 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>14.5 -15 0.4 0 0 0</pose>
    </model>

    <!-- 东围栏 (x=25) -->
    <model name="fence_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 30 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 30 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.5 0.32 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>25 0 0.4 0 0 0</pose>
    </model>

    <!-- 西围栏 (x=-25) -->
    <model name="fence_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 30 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 30 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.5 0.32 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-25 0 0.4 0 0 0</pose>
    </model>

    <!-- ============================================ -->
    <!-- 4. 苹果树（通过 include 引用 tree_model） -->
    <!-- 树高约1.65m（已按0.75缩放）；苹果由 FruitManager 动态生成在树冠表面。 -->
    <!-- ============================================ -->

    <!-- 第1排：y=4 -->
    <include>
      <uri>model://tree_model</uri>
      <name>tree_01</name>
      <pose>6 4 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_02</name>
      <pose>12 4 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_03</name>
      <pose>18 4 0 0 0 0</pose>
    </include>

    <!-- 第2排：y=0（中间通道） -->
    <include>
      <uri>model://tree_model</uri>
      <name>tree_04</name>
      <pose>9 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_05</name>
      <pose>15 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_06</name>
      <pose>21 0 0 0 0 0</pose>
    </include>

    <!-- 第3排：y=-4 -->
    <include>
      <uri>model://tree_model</uri>
      <name>tree_07</name>
      <pose>6 -4 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_08</name>
      <pose>12 -4 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://tree_model</uri>
      <name>tree_09</name>
      <pose>18 -4 0 0 0 0</pose>
    </include>

    <!-- Apples are managed at runtime through the UserCommands services. -->

    <!-- ============================================ -->
    <!-- 6. 物理参数（全局） -->
    <!-- ============================================ -->
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" default="true" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>
