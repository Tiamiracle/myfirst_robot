          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      <pose>-4 2.5 3 0 0 0</pose>
    </model>

    <!-- 儿童房西墙 (x=4, y=-6 to y=4) - 带门洞（门宽2m，分成两段墙） -->
    <model name="wall_children_west_bottom">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
