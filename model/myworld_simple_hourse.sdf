      <pose>-3.5 4 3 0 0 0</pose>
    </model>

    <!-- 次卧南墙 (y=4, x=0 to x=12) - 带门洞（门宽2m，分成两段墙） -->
    <model name="wall_second_south_left">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7 0.4 6</size>
            </box>
