<?xml version="1.0"?>
<robot name="vehicle_blue">

  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.667 0.333 0.167" />
      </geometry>
      <material>
        <color rgba="0.00000392 0.00000392 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.667 0.333 0.167" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.14395" />
      <inertia ixx="0.095329" ixy="0" ixz="0" iyy="0.381317" iyz="0" izz="0.476646" />
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
      <material>
        <color rgba="1 0.00000392 0.00000392 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
      <material>
        <color rgba="1 0.00000392 0.00000392 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.13" length="0.01" />
      </geometry>
      <material>
        <color rgba="0.50196471 0.50196471 0.50196471 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.13" length="0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008" />
    </inertial>
  </link>

  <link name="laser_cylinder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.3" />
      </geometry>
      <material>
        <color rgba="0 0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.05" />
      </geometry>
      <material>
        <color rgba="0 0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <joint name="caster_joint" type="revolute">
    <parent link="base_link" />
    <child link="caster_wheel" />
    <origin xyz="0.33 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-3.1415927" upper="3.1415927" effort="100" velocity="10" />
  </joint>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <joint name="left_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.167 0.2 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="10" />
  </joint>

  <joint name="right_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="-0.167 -0.2 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="10" />
  </joint>

  <joint name="laser_cylinder_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_cylinder_link" />
    <origin xyz="0.3 0 0.12" rpy="0 0 0" />
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="laser_cylinder_link" />
    <child link="laser_link" />
    <origin xyz="0 0 0.15000000000000002" rpy="0 0 0" />
  </joint>

  <!-- ============================================================ -->
  <!-- 4-DOF 吸盘机械臂（与 myrobotv52.sdf 的 link/joint 名逐字一致） -->
  <!-- 用于 robot_state_publisher 广播 TF；URDF 关节 origin 相对父连杆 -->
  <!-- ============================================================ -->

  <link name="arm_yaw_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry><cylinder radius="0.04" length="0.10" /></geometry>
      <material><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry><cylinder radius="0.04" length="0.10" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.00074" ixy="0" ixz="0" iyy="0.00074" iyz="0" izz="0.00048" />
    </inertial>
  </link>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0" />
      <geometry><cylinder radius="0.035" length="0.60" /></geometry>
      <material><color rgba="1 0.5 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.30" rpy="0 0 0" />
      <geometry><cylinder radius="0.035" length="0.60" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.024245" ixy="0" ixz="0" iyy="0.024245" iyz="0" izz="0.00049" />
    </inertial>
  </link>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0" />
      <geometry><cylinder radius="0.03" length="0.60" /></geometry>
      <material><color rgba="1 0.5 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.30" rpy="0 0 0" />
      <geometry><cylinder radius="0.03" length="0.60" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.018135" ixy="0" ixz="0" iyy="0.018135" iyz="0" izz="0.00027" />
    </inertial>
  </link>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <geometry><cylinder radius="0.025" length="0.20" /></geometry>
      <material><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <geometry><cylinder radius="0.025" length="0.20" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.000872" ixy="0" ixz="0" iyy="0.000872" iyz="0" izz="0.000078" />
    </inertial>
  </link>

  <link name="suction_cup_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry><cylinder radius="0.06" length="0.05" /></geometry>
      <material><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry><cylinder radius="0.06" length="0.05" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.000111" ixy="0" ixz="0" iyy="0.000111" iyz="0" izz="0.00018" />
    </inertial>
  </link>

  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link" />
    <child link="arm_yaw_link" />
    <origin xyz="-0.15 0 0.0835" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1415926" upper="3.1415926" effort="50" velocity="5" />
  </joint>

  <joint name="joint2_shoulder_pitch" type="revolute">
    <parent link="arm_yaw_link" />
    <child link="upper_arm_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0" upper="2.0" effort="50" velocity="5" />
  </joint>

  <joint name="joint3_elbow_pitch" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin xyz="0 0 0.60" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0" upper="2.0" effort="50" velocity="5" />
  </joint>

  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_link" />
    <origin xyz="0 0 0.60" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0" upper="2.0" effort="50" velocity="5" />
  </joint>

  <joint name="suction_fixed_joint" type="fixed">
    <parent link="wrist_link" />
    <child link="suction_cup_link" />
    <origin xyz="0 0 0.20" rpy="0 0 0" />
  </joint>

</robot>