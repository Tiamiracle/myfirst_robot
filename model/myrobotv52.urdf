<?xml version="1.0"?>
<robot name="vehicle_blue">

  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.667 0.333 0.167" />
      </geometry>
      <material>
        <color rgba="0.00000392 0.00000392 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.667 0.333 0.167" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.14395" />
      <inertia ixx="0.095329" ixy="0" ixz="0" iyy="0.381317" iyz="0" izz="0.476646" />
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
      <material>
        <color rgba="1 0.00000392 0.00000392 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
      <material>
        <color rgba="1 0.00000392 0.00000392 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.133" length="0.067" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.13" length="0.01" />
      </geometry>
      <material>
        <color rgba="0.50196471 0.50196471 0.50196471 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.13" length="0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008" />
    </inertial>
  </link>

  <link name="laser_cylinder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.3" />
      </geometry>
      <material>
        <color rgba="0 0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.043333" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.043333" />
    </inertial>
  </link>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.05" />
      </geometry>
      <material>
        <color rgba="0 0 0 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.02" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <joint name="caster_joint" type="revolute">
    <parent link="base_link" />
    <child link="caster_wheel" />
    <origin xyz="0.33 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-3.1415927" upper="3.1415927" effort="100" velocity="10" />
  </joint>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <joint name="left_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.167 0.2 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="10" />
  </joint>

  <joint name="right_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="-0.167 -0.2 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.79769e+308" upper="1.79769e+308" effort="100" velocity="10" />
  </joint>

  <joint name="laser_cylinder_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_cylinder_link" />
    <origin xyz="0.3 0 0.12" rpy="0 0 0" />
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="laser_cylinder_link" />
    <child link="laser_link" />
    <origin xyz="0 0 0.15000000000000002" rpy="0 0 0" />
  </joint>

  <!-- ============================================================ -->
  <!-- 果园采摘机械臂（完全按照PDF第5章 orchard_robot 定义）       -->
  <!-- link/joint名称与SDF逐字一致，用于robot_state_publisher     -->
  <!-- ============================================================ -->

  <!-- 1. 升降机构基座 -->
  <link name="lift_base">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry><box size="0.12 0.12 0.2" /></geometry>
      <material><color rgba="0.30196471 0.30196471 0.30196471 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry><box size="0.12 0.12 0.2" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.2" />
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004" />
    </inertial>
  </link>

  <!-- 2. 升降滑轨 -->
  <link name="lift_slide">
    <visual>
      <origin xyz="0 0 0.6" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 1" /></geometry>
      <material><color rgba="0.20000392 0.60000392 0.80000392 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.6" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 1.2" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.6" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.28" ixy="0" ixz="0" iyy="0.28" iyz="0" izz="0.002" />
    </inertial>
  </link>

  <!-- 3. 升降平台 -->
  <link name="lift_platform">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry><box size="0.3 0.25 0.08" /></geometry>
      <material><color rgba="0.10196471 0.70196471 0.40000392 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry><box size="0.3 0.25 0.08" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.011" />
    </inertial>
  </link>

  <!-- 4. 手臂旋转基座 -->
  <link name="arm_rot_base">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0" />
      <geometry><cylinder radius="0.07" length="0.09" /></geometry>
      <material><color rgba="0.60000392 0.60000392 0.60000392 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0" />
      <geometry><cylinder radius="0.07" length="0.09" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0018" />
    </inertial>
  </link>

  <!-- 5. 大臂 -->
  <link name="arm_upper_link">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0" />
      <geometry><box size="0.4 0.06 0.06" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0" />
      <geometry><box size="0.4 0.06 0.06" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0092" iyz="0" izz="0.0092" />
    </inertial>
  </link>

  <!-- 6. 伸缩前臂 -->
  <link name="arm_extend_forearm">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0" />
      <geometry><box size="0.3 0.05 0.05" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0" />
      <geometry><box size="0.3 0.05 0.05" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0038" iyz="0" izz="0.0038" />
    </inertial>
  </link>

  <!-- 7. 腕部旋转 -->
  <link name="arm_wrist_rot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 0.08" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.08 0.08 0.08" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- 8. 夹爪基座 -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.05 0.15 0.15" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.05 0.15 0.15" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00008" />
    </inertial>
  </link>

  <!-- 9. 手指1 (右侧) -->
  <link name="finger_1">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000008" />
    </inertial>
  </link>

  <!-- 10. 手指2 (左侧) -->
  <link name="finger_2">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000008" />
    </inertial>
  </link>

  <!-- 11. 手指3 (上方) -->
  <link name="finger_3">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
      <material><color rgba="0.94902353 0.94118039 0.90980784 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <geometry><box size="0.1 0.02 0.02" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000008" />
    </inertial>
  </link>

  <!-- ==================== 关节定义（按PDF第5章） ==================== -->

  <!-- 升降基座固定关节 -->
  <joint name="lift_base_joint" type="fixed">
    <parent link="base_link" />
    <child link="lift_base" />
    <origin xyz="-0.25 0 0.167" rpy="0 0 0" />
  </joint>

  <!-- 滑轨固定关节 -->
  <joint name="lift_slide_joint" type="fixed">
    <parent link="base_link" />
    <child link="lift_slide" />
    <origin xyz="-0.25 0 0.167" rpy="0 0 0" />
  </joint>

  <!-- 升降平台关节 (prismatic, Z轴, 0~0.8m) -->
  <joint name="platform_joint" type="prismatic">
    <parent link="lift_slide" />
    <child link="lift_platform" />
    <origin xyz="0 0 0.333" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.8" effort="200" velocity="0.3" />
  </joint>

  <!-- 手臂旋转关节 (revolute, Z轴, -π~π) -->
  <joint name="arm_rot_joint" type="revolute">
    <parent link="lift_platform" />
    <child link="arm_rot_base" />
    <origin xyz="0 0 0.115" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="150" velocity="1.2" />
  </joint>

  <!-- 大臂俯仰关节 (revolute, Y轴, -0.785~1.57) -->
  <joint name="arm_upper_pitch_joint" type="revolute">
    <parent link="arm_rot_base" />
    <child link="arm_upper_link" />
    <origin xyz="0 0 0.09" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.785" upper="1.57" effort="120" velocity="1" />
  </joint>

  <!-- 前臂伸缩关节 (prismatic, X轴, 0~0.3m) -->
  <joint name="arm_forearm_extend_joint" type="prismatic">
    <parent link="arm_upper_link" />
    <child link="arm_extend_forearm" />
    <origin xyz="0 0 0.363" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.3" effort="80" velocity="0.25" />
  </joint>

  <!-- 腕部旋转关节 (revolute, X轴, -1.57~1.57) -->
  <joint name="wrist_rotate_joint" type="revolute">
    <parent link="arm_extend_forearm" />
    <child link="arm_wrist_rot" />
    <origin xyz="0.18 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="40" velocity="1.5" />
  </joint>

  <!-- 夹爪基座固定关节 -->
  <joint name="gripper_fixed_joint" type="fixed">
    <parent link="arm_wrist_rot" />
    <child link="gripper_base" />
    <origin xyz="0.06 0 0" rpy="-3.1415926 0 -3.1415926" />
  </joint>

  <!-- 手指1关节 (revolute, Y轴, -0.6~0.6) -->
  <joint name="finger1_joint" type="revolute">
    <parent link="gripper_base" />
    <child link="finger_1" />
    <origin xyz="0 0.04 -0.07" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.6" upper="0.6" effort="15" velocity="2" />
  </joint>

  <!-- 手指2关节 (revolute, Y轴, -0.6~0.6) -->
  <joint name="finger2_joint" type="revolute">
    <parent link="gripper_base" />
    <child link="finger_2" />
    <origin xyz="0 -0.04 -0.07" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.6" upper="0.6" effort="15" velocity="2" />
  </joint>

  <!-- 手指3关节 (revolute, Y轴, -0.6~0.6) -->
  <joint name="finger3_joint" type="revolute">
    <parent link="gripper_base" />
    <child link="finger_3" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.6" upper="0.6" effort="15" velocity="2" />
  </joint>

</robot>