Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RGB Camera1
        - /Depth Camera1
      Splitter Ratio: 0.5
    Tree Height: 578
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: TF
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /apple_hsv_detector/debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Apple Detection Debug
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /apple_hsv_detector/mask
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Apple HSV Mask
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /apple_hsv_detector/markers
      Name: Apple 3D Positions
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/image_raw
      Max Value: 8
      Median window: 5
      Min Value: 0.1
      Name: Depth Camera
      Normalize Range: false
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
  X: 100
  Y: 100
